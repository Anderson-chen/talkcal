#!/usr/bin/env bash
# git push 之前先掃祕密、在乾淨的容器裡執行一遍 CI（ci/run.sh），沒過就不推。
# GitHub 的 CI 沒有 GPU，模型相關的測試只有在這台開著 llama-server 的電腦上才會真的執行。
#
# 每個 clone 要自己啟用一次，git clone 不會帶上 hook：
#   git config core.hooksPath .githooks
# 確定要跳過檢查：
#   git push --no-verify

set -euo pipefail

# git 從 stdin 給每個要推的 ref：<本機 ref> <本機 sha> <遠端 ref> <遠端 sha>。
# 測的是要推的那個 commit，不一定是 HEAD（例如推別的分支時）
zero=0000000000000000000000000000000000000000
# 改到這些就要執行 AI eval：助理和工具（system prompt 在這裡）、抽取（抽取也有 prompt）、eval 的題目和評分、
# application.properties（用哪個模型、溫度、max-tokens）
EVAL_PATHS='^backend/src/main/java/io/github/andersonchen/talkcal/calendar/adapter/(in/assistant|out/extraction)/|^backend/src/eval/|^backend/src/main/resources/application[^/]*\.properties$'
while read -r local_ref local_sha _ _; do
    # 刪除遠端分支時本機 sha 是全 0，沒有東西要測
    [ "$local_sha" = "$zero" ] && continue
    echo "pre-push：檢查 ${local_ref#refs/heads/} ($(git rev-parse --short "$local_sha"))"
    # 祕密先掃：只要幾秒，而且測試失敗可以修好再推，key 送出去就只能作廢重發。
    # --not --remotes 是還不在任何遠端分支上的 commit，也就是這次真的會送出去的那些
    ci/secrets.sh "$local_sha" --not --remotes </dev/null
    # AI eval 要一分多鐘，只在這次送出去的 commit 改到 prompt 或模型相關的檔案時執行。
    # 改了 prompt 卻沒執行的話，模型的回答變差也沒人發現
    if git log --name-only --format= "$local_sha" --not --remotes | grep -qE "$EVAL_PATHS"; then
        echo "pre-push：改到 prompt 或模型相關的檔案，這次也跑 AI eval"
        RUN_EVAL=1 ci/run.sh "$local_sha" </dev/null
    else
        ci/run.sh "$local_sha" </dev/null
    fi
done
