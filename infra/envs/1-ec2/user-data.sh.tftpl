#!/bin/bash
# 第一次開機時跑一次：確認 AMI 帶的東西都在、補齊缺的、clone repo、跑第一次部署。
# 之後的部署都是重跑 deploy.sh，不再經過這裡。
# 這是 Terraform 範本：$${...} 會被 Terraform 代換，所以下面的 bash 變數一律寫成 $VAR，不加大括號。
set -euxo pipefail
exec > >(tee /var/log/user-data.log | logger -t user-data) 2>&1

# ── 1. Docker（gpu 時還有 GPU）──────────────────────────────────────────────────
%{ if model_backend == "gpu" ~}
# Deep Learning AMI 應該都裝好了，這裡只驗證。
# 印出驅動版本：llama-server 映像檔是 CUDA 13，驅動要 580 以上
nvidia-smi
command -v docker
command -v nvidia-ctk

# 讓 Docker 認得 GPU（AMI 通常已經設好；重跑一次無害，只會確保 daemon.json 有 nvidia runtime）
nvidia-ctk runtime configure --runtime=docker
%{ else ~}
# 一般的 Ubuntu 沒帶 Docker，從 Docker 官方的 apt 套件庫裝（Ubuntu 自己的 docker.io 版本舊、沒有 compose 外掛）。
# 步驟照 https://docs.docker.com/engine/install/ubuntu/ ，compose 和 buildx 外掛一起裝。
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl git python3
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
. /etc/os-release
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $VERSION_CODENAME stable"   > /etc/apt/sources.list.d/docker.list
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

# deploy.sh 要用 AWS CLI 讀 SSM 的 .env；Deep Learning AMI 有帶，一般 Ubuntu 沒有。
# 用 AWS 官方的安裝程式（apt 的 awscli 是舊的 v1）。不用 snap 版：2026-10-14 實測，
# snap 的 aws 輸出導向檔案時（> deploy/.env）結束碼 0 但寫出 0 bytes，導向管線才正常 ——
# .env 變成空的，compose 才在第 4 步報缺變數（#74）
if ! command -v aws; then
  apt-get install -y unzip
  curl -fsSL -o /tmp/awscliv2.zip https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install
  rm -rf /tmp/aws /tmp/awscliv2.zip
fi
aws --version
%{ endif ~}

# log 輪替：Docker 預設的 json-file 不輪替，log 會一直長到磁碟滿。
# 用合併的方式寫進 daemon.json：gpu 時上面 nvidia-ctk 寫的 runtime 設定不能被蓋掉。
python3 - <<'PY'
import json, os
p = "/etc/docker/daemon.json"
cfg = json.load(open(p)) if os.path.exists(p) else {}
cfg["log-driver"] = "json-file"
cfg["log-opts"] = {"max-size": "10m", "max-file": "3"}
json.dump(cfg, open(p, "w"), indent=2)
PY
systemctl restart docker

# compose 和 buildx 是 Docker CLI 的外掛。沒有的話（AMI 沒帶）補裝固定版本：
#   compose：deploy/ 和 ops/ 兩組都靠它
#   buildx ：backend 的 Dockerfile 用了 RUN --mount=type=cache，要 BuildKit 才 build 得動
PLUGINS=/usr/local/lib/docker/cli-plugins
mkdir -p $PLUGINS
if ! docker compose version; then
  curl -fsSL -o $PLUGINS/docker-compose \
    https://github.com/docker/compose/releases/download/v2.32.4/docker-compose-linux-x86_64
  chmod +x $PLUGINS/docker-compose
fi
if ! docker buildx version; then
  curl -fsSL -o $PLUGINS/docker-buildx \
    https://github.com/docker/buildx/releases/download/v0.20.1/buildx-v0.20.1.linux-amd64
  chmod +x $PLUGINS/docker-buildx
fi
docker compose version
docker buildx version

# ── 2. 部署設定：寫成檔案，之後手動重跑 deploy.sh 時自動讀 ────────────────────────
mkdir -p /opt/${project}
cat > /opt/${project}/deploy.env <<'ENV'
PROJECT=${project}
AWS_REGION=${region}
GIT_REF=${git_ref}
MODEL_BACKEND=${model_backend}
MODELS_BUCKET=${models_bucket}
DOTENV_PARAM=${dotenv_param}
ENV

# ── 3. 原始碼 ────────────────────────────────────────────────────────────────
if [ ! -d /opt/${project}/repo/.git ]; then
  git clone ${repo_url} /opt/${project}/repo
fi
git -C /opt/${project}/repo fetch --depth 1 origin ${git_ref}
git -C /opt/${project}/repo checkout --detach FETCH_HEAD

# ── 4. 第一次部署 ────────────────────────────────────────────────────────────
# 第一次要 build 映像檔、拉映像檔，會跑很久（gpu 還要編 llama-server 的 CUDA、複製模型，十幾分鐘）。
# 進度看 /var/log/user-data.log。
bash /opt/${project}/repo/infra/envs/1-ec2/deploy.sh
