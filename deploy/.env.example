# 本機的祕密：cp deploy/.env.example deploy/.env 再填值。.env 不進 git，pre-push 的祕密掃描也會擋。
# docker compose 自動讀 compose 檔旁邊的 .env；./gradlew bootRun 由 build.gradle 讀這份交給 app。
# 雲端不用這份範本：deploy.sh 把 SSM 裡的完整 .env 寫到同一個位置（內容見 infra/envs/1-ec2/secrets.tf）。

# 沒填的話 compose、bootRun 都拒絕啟動。資料庫只在 volume 第一次初始化時讀密碼，
# 已經有 postgres-data 的話要填當初的密碼；要換，先進資料庫 ALTER ROLE talkcal PASSWORD '...'，再改這裡（見 deploy/README.md）
DB_PASSWORD=

# Google、GitHub 登入，沒填的那個就不開。要登記的回呼網址是 http://localhost:5173/api/auth/oauth2/callback/google
# （GitHub 把最後一段換成 github）。從 deploy/ 的 nginx 進來時，Google 再加一條 http://localhost:18080/...；
# GitHub 的 OAuth App 只能填一個。回呼網址照請求的 Host 組，直接開 bootRun 的 8090 會跟登記的對不上（redirect_uri_mismatch）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Grafana 告警寄信，ops/ 那組讀：cd ops && docker compose --env-file ../deploy/.env up -d。ALERT_SMTP_HOST 沒填就不寄。
# 只想在本機試寄信：ALERT_SMTP_HOST=mailpit:1025、其他留空，起 ops/ 時加 --profile mailtest，信在 http://localhost:8025。
# 寄到真的信箱用 STARTTLS 的 587，例如 smtp.gmail.com:587 配 Gmail 的應用程式密碼，或 SES 的 SMTP 帳密
ALERT_SMTP_HOST=
ALERT_SMTP_USER=
# 有 $ 的話整個用單引號包起來（'ab$cd'），不然 compose 讀 --env-file 時會把 $xxx 當變數展開
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
# 多個收件人用分號分開
ALERT_EMAIL_TO=

# Grafana 打的 heartbeat 網址，**現在留空**：還沒有打 heartbeat 的 Watchdog 規則（為什麼見 ops/README.md），填了 check 會一直 DOWN。
# 有了 Watchdog 之後：在 https://healthchecks.io 新增 check（Period 1 minute、Grace 5 minutes），貼上它的 Ping URL。
# 拿到網址的人能替我們假裝還活著，跟密碼一樣不進 git。本機跟雲端要用不同的 check：共用的話本機一直在打，雲端停了也看不出來
HEARTBEAT_URL=

# 本機 RustFS 用這組帳密建起來，app 用同一組連，自己填兩個值（secret 至少 8 個字）。
# 雲端換成專用 IAM user 的 access key（infra/envs/1-ec2/archive.tf）
ARCHIVE_ACCESS_KEY=
ARCHIVE_SECRET_KEY=
