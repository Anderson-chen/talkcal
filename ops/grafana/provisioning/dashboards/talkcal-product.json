      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (origin) (increase(talkcal_calendar_events_added_total{job=\"talkcal-app\"}[$__range]))",
          "legendFormat": "{{origin}}",
          "instant": true,
          "range": false
