      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(increase(talkcal_assistant_proposals_shown_total{job=\"talkcal-app\"}[1h]))",
          "legendFormat": "提議"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(increase(talkcal_calendar_events_added_total{job=\"talkcal-app\",origin=\"assistant\"}[1h]))",
          "legendFormat": "採納"
