{
  "uid": "llama-embedding",
  "title": "llama.cpp — 嵌入伺服器 (bge-m3)",
  "tags": ["eat", "llm", "embedding"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "嵌入吞吐 (tokens/s)",
      "description": "llamacpp:prompt_tokens_seconds{job=\"llama-embedding\"} —— 這台把文字讀進去、算成向量的速度。嵌入伺服器只有『讀進來』這個階段，所以這條就是它的主吞吐指標，地位等同 LLM 那張圖的『生成速度』。注意 job 過濾一定要帶：8080 的 LLM 也吐同名指標，不過濾就會兩台混在一起。",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "llamacpp:prompt_tokens_seconds{job=\"llama-embedding\"}",
          "legendFormat": "嵌入 t/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "請求：處理中 vs 排隊中",
      "description": "requests_processing（正在算）與 requests_deferred（排隊等）。嵌入通常是「短而密」的流量 —— 一次 RAG 檢索可能同時丟進幾十段文字，所以這裡比 LLM 那邊更容易看到 deferred 抬頭。deferred 離開 0 就是併發超過這台能同時吃的量。",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "llamacpp:requests_processing{job=\"llama-embedding\"}",
          "legendFormat": "處理中"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "llamacpp:requests_deferred{job=\"llama-embedding\"}",
          "legendFormat": "排隊中"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "auto", "stacking": { "mode": "none" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "累計處理 tokens",
      "description": "counter：prompt_tokens_total —— 這台自啟動以來總共嵌入了幾個 token，只增不減。看的是『做了多少工』的絕對量。它旁邊那張『每秒速率』就是從這條 counter 算出來的（見右下角那個 panel）。這裡刻意不放 tokens_predicted_total：嵌入伺服器不生成 token，那條永遠是 0。",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "llamacpp:prompt_tokens_total{job=\"llama-embedding\"}",
          "legendFormat": "累計嵌入 tokens"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "每秒嵌入速率（由 counter 推算）",
      "description": "rate(prompt_tokens_total[1m]) —— 用 rate() 從 counter 算出的每秒速率。窗口 1m 是抓取間隔 15s 的 4 倍，保證窗內有足夠樣本、圖不會斷；跟其他儀表板的 rate() 一致。這跟左上角那張的差別，正是這個 panel 存在的理由 —— 左上是 llama.cpp 自己回報的『最後一批的瞬時平均』，這裡要的是 Prometheus 依時間窗自己算出來的『持續速率』。前者會在閒置時卡住不動，後者閒置時會掉到 0。",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "rate(llamacpp:prompt_tokens_total{job=\"llama-embedding\"}[1m])",
          "legendFormat": "嵌入 t/s（rate）"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    }
  ]
}
