{
  "uid": "talkcal-k6",
  "title": "talkcal — 壓測（k6）",
  "tags": [
    "talkcal",
    "k6"
  ],
  "description": "k6 的指標和 app、模型的指標疊在同一個時間軸上。跑法：perf/run-to-grafana.sh，見 perf/README.md。",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "k6 那一側：使用者感受到的",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "同時在用的人（VU）",
      "description": "k6 同時跑著幾個虛擬使用者。knee.js 每一階會看到一個平台，load.js 是 below / at / above 三段。其他圖的變化都對照這一條看：人數一變，延遲、排隊跟著怎麼動。 k6 收工後不會再送這個數字，預設會沿用最後一個值五分鐘，看起來像人還在；所以只看最近 15 秒（k6 每 5 秒送一次）。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(last_over_time(k6_vus{job=\"k6\"}[15s]))",
          "legendFormat": "VU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "請求速率，依狀態碼 (req/s)",
      "description": "k6 送出、而且收到回應的請求數。吞吐量不再隨 VU 增加，就是到頂了（knee）。status=0 代表沒拿到任何回應（逾時、連不上）。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (status) (rate(k6_http_reqs_total{job=\"k6\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "延遲 p50 / p95（k6 量的）",
      "description": "從 k6 送出請求到收完回應的時間，只算預期內的回應（smoke 故意送錯、預期回 400 的那些不算）。k6 用 exponential histogram 送進來，沒有固定的 bucket 上限，LLM 慢到幾十秒也量得準。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.5, sum(rate(k6_http_req_duration_milliseconds{job=\"k6\", expected_response=\"true\"}[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_milliseconds{job=\"k6\", expected_response=\"true\"}[1m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "失敗率、check 失敗率",
      "description": "http_req_failed：不在預期內的回應（5xx、逾時、預期 200 卻拿到 400）佔幾成。check 失敗：腳本自己的檢查（reply 不能空白、要有 conversationId）沒過的比例。兩條都應該貼在 0。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(sum(rate(k6_http_req_failed_total{job=\"k6\", condition=\"nonzero\"}[1m])) or vector(0)) / sum(rate(k6_http_req_failed_total{job=\"k6\"}[1m]))",
          "legendFormat": "http_req_failed"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(sum(rate(k6_checks_total{job=\"k6\", condition=\"zero\"}[1m])) or vector(0)) / sum(rate(k6_checks_total{job=\"k6\"}[1m]))",
          "legendFormat": "check 失敗"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "server 那一側：同一段時間裡 app 和模型在做什麼",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "同一個請求，兩頭量的 p95",
      "description": "k6 量的是使用者從送出到收完，app 量的是 Tomcat 收到到送出。兩條差不多：時間都花在 app 和模型裡面。k6 那條明顯比較高：請求在進到 app 之前就在排隊（連線、執行緒不夠），或卡在網路上。注意 app 那條只看得到 docker 那台 app（Alloy 只抓它）。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.95, sum(rate(k6_http_req_duration_milliseconds{job=\"k6\", expected_response=\"true\", name=~\".*/api/calendar/assistant\"}[1m]))) / 1000",
          "legendFormat": "k6（使用者那頭）"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/calendar/assistant\"}[1m])))",
          "legendFormat": "app（server 那頭）"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "模型：處理中 vs 排隊中",
      "description": "llama-server 有幾個請求正在生成、幾個在等 slot。排隊中離開 0 的那一刻，延遲就會開始往上爬——對照 VU 那張圖，就知道是幾個人時開始塞。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "llamacpp:requests_processing{job=\"llama-cpp\"}",
          "legendFormat": "處理中"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "llamacpp:requests_deferred{job=\"llama-cpp\"}",
          "legendFormat": "排隊中"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "app 回 5xx 的速率",
      "description": "AI 助理回 502（模型或資料庫出事）的次數。k6 的失敗率升高時，先看這裡：有 5xx 是 app 這頭回錯，沒有的話是請求根本沒回來（逾時、連線被砍）。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{uri=\"/api/calendar/assistant\", status=~\"5..\"}[1m])) or vector(0))",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "模型生成速度 (tokens/s)",
      "description": "每個請求平均每秒生幾個 token。同時處理的請求變多，每個分到的 GPU 算力變少，這條會往下掉——這就是延遲變長的原因之一。",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "llamacpp:predicted_tokens_seconds{job=\"llama-cpp\"}",
          "legendFormat": "tokens/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
