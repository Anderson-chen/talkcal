// 三種訊號都經過這個 Alloy：Alloy 抓指標寫進 Mimir、讀 deploy/ 容器的 stdout 送進 Loki，
// 也接收 app、nginx 用 OTLP 送來的 trace，轉進 Tempo。為什麼只有一個收集器，見 docs/adr/0007-alloy-to-mimir-loki-tempo.md。
// 管線圖：http://localhost:12345


// ═══ 指標 ═══════════════════════════════════════════════════════════
//
// target 寫「服務名:容器內的埠」：Alloy 接在 deploy/ 的 Docker 網路上（見 ops/compose.yaml）。
// 本機 bootRun 的 app 不在那個網路裡，抓不到。
// job_name 每個都寫明：不寫的話 job 標籤是元件名（prometheus.scrape.talkcal_app），dashboard 和告警的查詢都對不上。
// scrape_interval 也寫明：Alloy 預設 60 秒，告警的 for 是照 15 秒抓一次算的。

// /actuator 只在 management 埠 8091，API 的 8090 上沒有
prometheus.scrape "talkcal_app" {
  job_name        = "talkcal-app"
  targets         = [{"__address__" = "app:8091"}]
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

// llama-server 要帶 --metrics 才有 /metrics。這個 build 沒有 kv_cache 相關的指標，
// 有哪些以 `curl localhost:8080/metrics` 為準
prometheus.scrape "llama_cpp" {
  job_name        = "llama-cpp"
  targets         = [{"__address__" = "llm-chat:8080"}]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

// 資料庫是否正常看 pg_up，不看這個 job 的 up：up 只代表 exporter 本身在執行
prometheus.scrape "postgres" {
  job_name        = "postgres"
  targets         = [{"__address__" = "postgres-exporter:9187"}]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

// 備份是執行完就結束的批次工作（infra/envs/1-ec2/backup-to-s3.sh），沒有 /metrics。
// 備份成功時寫 .prom 檔（textfile collector），這裡讀；資料夾由 ops/compose.yaml 掛進來，本機是空的。
// 為什麼用 textfile、不用 Pushgateway，見 docs/alerts.md 的備份那段。
// stat 給 node_boot_time_seconds：容器跟主機共用核心，讀到的是主機開機時間，備份告警用這個值排除剛開機
// （見 grafana/provisioning/alerting/respond.yaml）。其他 collector 在容器裡讀到的不是主機的值，不開。
prometheus.exporter.unix "backup" {
  set_collectors = ["textfile", "stat"]
  textfile {
    directory = "/var/lib/alloy/textfile"
  }
}

// exporter 的 target 自帶 job="integrations/unix"，target 上的 job 會蓋過 scrape 的 job_name，只能在這裡改。
// instance 預設是容器的 hostname，Alloy 容器重建一次就換一個，序列會斷成兩條
discovery.relabel "backup" {
  targets = prometheus.exporter.unix.backup.targets
  rule {
    target_label = "job"
    replacement  = "talkcal-backup"
  }
  rule {
    target_label = "instance"
    replacement  = "alloy"
  }
}

prometheus.scrape "backup" {
  job_name        = "talkcal-backup"
  targets         = discovery.relabel.backup.output
  // 告警的查詢只往回找 5 分鐘內的點，間隔要比 5 分鐘短
  scrape_interval = "1m"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

// Alloy 抓自己：Alloy 停了，up{job="alloy"} 就不再有新的點，告警看最後一個點有多舊
// （見 grafana/provisioning/alerting/meta-monitoring.yaml）
prometheus.exporter.self "alloy" { }

// 自帶 job="integrations/self"，原因同上面 discovery.relabel "backup"
discovery.relabel "alloy" {
  targets = prometheus.exporter.self.alloy.targets
  rule {
    target_label = "job"
    replacement  = "alloy"
  }
}

prometheus.scrape "alloy" {
  targets         = discovery.relabel.alloy.output
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

// job 是告警查詢用的名字（up{job="loki"}），改了要一起改 meta-monitoring.yaml
prometheus.scrape "observability" {
  targets = [
    {"__address__" = "mimir:9009",   "job" = "mimir"},
    {"__address__" = "loki:3100",    "job" = "loki"},
    {"__address__" = "tempo:3200",   "job" = "tempo"},
    {"__address__" = "grafana:3000", "job" = "grafana"},
  ]
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.observability_up_only.receiver]
}

// 只留 up，告警只用到 up。這四個元件自己的指標有好幾千條，全收會讓小機器上的 Mimir 多存一大份
prometheus.relabel "observability_up_only" {
  rule {
    source_labels = ["__name__"]
    regex         = "up"
    action        = "keep"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
    // k6 的延遲是 native histogram（見 perf/run-to-grafana.sh）。不開的話 remote_write 會整批丟掉，不留錯誤訊息
    send_native_histograms = true
  }
}


// ═══ 日誌 ═══════════════════════════════════════════════════════════
//
// Alloy 停止一段時間也不會遺失 log：Docker 照樣寫自己的 log 檔，Alloy 重新啟動後照位置檔接著讀。

discovery.docker "deploy" {
  host = "unix:///var/run/docker.sock"

  // 只收 deploy/ 那組。不過濾的話，這台機器上別的專案和 ops/ 自己的容器 log 都會收進來
  filter {
    name   = "label"
    values = ["com.docker.compose.project=talkcal-deploy"]
  }
}

// Loki 只替標籤建索引，每多一種值就多一條 stream。標籤只放值只有幾種的（容器名、服務名）；
// trace id、使用者這種每筆不同的值放進標籤，stream 數會多到 Loki 無法負荷。trace id 留在內容裡，
// 由 Grafana 用 regex 從內容找出 trace id，做成連結（見 grafana/provisioning/datasources/datasources.yaml）。
discovery.relabel "deploy" {
  // 只定義規則，由 loki.source.docker 的 relabel_rules 套用
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  // 查詢用 service：compose 的服務名，容器重建、改名都不變
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    target_label = "env"
    replacement  = "docker"
  }
}

// 只讀得到 Docker 收下來的 stdout/stderr，容器裡寫進檔案的 log 收不到
loki.source.docker "deploy" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.deploy.targets
  relabel_rules = discovery.relabel.deploy.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}


// ═══ 追蹤 ═══════════════════════════════════════════════════════════
//
// receiver → transform（改 service map 用的屬性）→ tail_sampling → batch → Tempo

// app 用 HTTP（4318）：容器裡找 alloy:4318，本機 bootRun 走 ops/compose.yaml 發佈到主機的 127.0.0.1:4318。
// nginx 的 OpenTelemetry 模組只支援 gRPC，所以另開 4317，只在 deploy/ 的網路裡用。
// k6 的指標也從 4318 進來（見最下面的壓測）。
otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  output {
    traces  = [otelcol.processor.transform.service_graph.input]
    metrics = [otelcol.processor.batch.default.input]
  }
}

// Tempo 畫 service map 時，client span 加上接在底下的 server span 算一條邊；沒有 server span 的怎麼造節點見 tempo/tempo.yaml。
//
// 第一條：nginx 的模組一個請求只開一個 server span，沒有轉給 app 的 client span，
//   app 的 server span 直接接在 server span 底下，Tempo 配不成邊，圖上 talkcal-web 和 talkcal 之間就斷了。
//   那個 span 從收到到 app 回完，本來就涵蓋轉送，標成 client 就配得起來。
//   代價是圖上少了 nginx 前面的 user 節點：Tempo 只替最上層的 server span 造這個節點。
// 第二條：datasource-micrometer 把 SQL span 的 peer.service 設成資料庫名稱，資料庫剛好也叫 talkcal，
//   圖上會變成 talkcal 連自己。Tempo 取節點名稱時 peer.service 優先，tempo.yaml 改不掉，只能在這裡換成 postgresql
otelcol.processor.transform "service_graph" {
  error_mode = "ignore"
  trace_statements {
    context    = "span"
    statements = [
      `set(span.kind, SPAN_KIND_CLIENT) where resource.attributes["service.name"] == "talkcal-web" and span.kind == SPAN_KIND_SERVER`,
      `set(span.attributes["peer.service"], span.attributes["db.system.name"]) where span.attributes["db.system.name"] != nil`,
    ]
  }
  output {
    traces = [otelcol.processor.tail_sampling.default.input]
  }
}

// 錯的、慢的全留，其餘照比例抽。為什麼在這裡做 tail sampling、不在 app 端做 head sampling，見 ops/README.md 的「Trace 取樣」。
// app 端要維持全送，理由見 application.properties 的 management.tracing.sampling.probability。
// 一個 trace 的 span 都要進同一個 Alloy 才判斷得了；Alloy 變成多個時，前面要先照 trace id 分流。
//
// 本機不設環境變數，用 coalesce 的預設值（全留、5 秒）；雲端由 infra/envs/1-ec2/compose.ops.yaml 給 10%、125 秒。
otelcol.processor.tail_sampling "default" {
  // 從第一個 span 到達開始算。根 span 在請求結束時才送、最後到，等不夠久的話慢請求看起來不慢，會被當一般請求抽掉。
  // 雲端要比最久的請求還長：呼叫模型最多等 2 分鐘（spring.ai.openai.chat.timeout），所以設成 125 秒。
  // 本機全留，等多久都一樣，短一點 trace 才早點查得到
  decision_wait = coalesce(sys.env("TRACE_SAMPLING_DECISION_WAIT"), "5s")

  // 同時在記憶體裡等決定的 trace 數，滿了最舊的被迫先決定。每秒 50 個請求 × 125 秒 ≈ 6,250，留三倍
  num_traces = 20000

  // 決定之後才到的 span 照同一個決定處理。不記的話晚到的 span 會被當新 trace 重新抽，Tempo 裡出現半截的 trace。
  // 只存 trace id，官方建議給得比 num_traces 大很多
  decision_cache = {
    sampled_cache_size     = 200000,
    non_sampled_cache_size = 200000,
  }

  // 任一條 policy 判定保留，trace 就保留
  policy {
    name = "errors"
    type = "status_code"
    status_code {
      status_codes = ["ERROR"]
    }
  }

  // 5xx 要另外一條：Spring 的 HTTP span 回 500 時狀態是 UNSET，只有 outcome 屬性記著 SERVER_ERROR
  // （例如連線池等不到連線的 500）。4xx 不全留：未登入、找不到量大，又不代表系統出問題
  policy {
    name = "server-errors"
    type = "string_attribute"
    string_attribute {
      key    = "outcome"
      values = ["SERVER_ERROR"]
    }
  }

  // 助理正常一次約 2～3 秒，行程 API 幾十毫秒，5 秒是助理正常值的兩倍。
  // 門檻沒跟 SLO 的延遲目標（mimir/rules/anonymous/slo.yaml）對齊：比行程 SLO 慢、但不到 5 秒的只照比例留
  policy {
    name = "slow"
    type = "latency"
    latency {
      threshold_ms = 5000
    }
  }

  // 照 trace id 的雜湊抽，同一個 trace 的 span 不會一半留一半丟
  policy {
    name = "baseline"
    type = "probabilistic"
    probabilistic {
      // 環境變數是字串，sampling_percentage 要數字
      sampling_percentage = encoding.from_json(coalesce(sys.env("TRACE_SAMPLING_PERCENT"), "100"))
    }
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.k6.input]
  }
}

// 不走 TLS：Tempo 的 4317 只開在同一台機器的 compose 網路裡。Tempo 搬到別台機器時要改用憑證
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}


// ═══ 壓測（k6）══════════════════════════════════════════════════════
//
// k6 用 OTLP 把指標推到 4318（perf/run-to-grafana.sh），這裡翻成 Prometheus 格式寫進 Mimir。
// 為什麼經過 Alloy、不讓 k6 直接寫 Mimir，見 ops/README.md 的「壓測」。
// 翻譯後名稱的點換成底線、單位接在後面（k6_http_req_duration_milliseconds），service.name 變成 job 標籤；
// dashboard 照 Mimir 裡實際查到的名稱寫。
otelcol.exporter.prometheus "k6" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}
