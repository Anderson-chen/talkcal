{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit_map.py\" --hook",
            "timeout": 60,
            "statusMessage": "產生 commit 脈絡圖"
          }
        ]
      }
    ]
  }
}
